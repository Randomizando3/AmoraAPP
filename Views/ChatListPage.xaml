<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AmoraApp.Views.ChatListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:AmoraApp.Helpers"
    BackgroundColor="#F1F2F6"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Converter que trata PhotoUrl (URL normal ou autoAvatar://...) -->
            <helpers:AvatarSourceConverter x:Key="AvatarSourceConverter" />

            <!-- Badge de não lidas só aparece se UnreadCount > 0 -->
            <Style x:Key="UnreadBadgeStyle" TargetType="Frame">
                <Setter Property="IsVisible" Value="True" />
                <Style.Triggers>
                    <DataTrigger
                        TargetType="Frame"
                        Binding="{Binding UnreadCount}"
                        Value="0">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16,32,16,12">

        <!-- HEADER + FILTROS -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto">

            <!-- Título -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" VerticalOptions="Center">
                <Label
                    Text="Mensagens"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#262626"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Filtros -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Frame
                    CornerRadius="12"
                    BackgroundColor="White"
                    HasShadow="True"
                    Padding="2">
                    <Grid ColumnDefinitions="*,*,*,*">

                        <!-- Todos -->
                        <Button
                            Grid.Column="0"
                            Text="Todos"
                            Command="{Binding ChangeFilterCommand}"
                            CommandParameter="All"
                            FontSize="13"
                            HeightRequest="34"
                            CornerRadius="10"
                            Padding="0,4"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            TextColor="#777">
                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding CurrentFilter}"
                                    Value="All">
                                    <Setter Property="BackgroundColor" Value="#5d259c" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- Matches -->
                        <Button
                            Grid.Column="1"
                            Text="Matches"
                            Command="{Binding ChangeFilterCommand}"
                            CommandParameter="Matches"
                            FontSize="13"
                            HeightRequest="34"
                            CornerRadius="10"
                            Padding="0,4"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            TextColor="#777">
                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding CurrentFilter}"
                                    Value="Matches">
                                    <Setter Property="BackgroundColor" Value="#5d259c" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- Amigos -->
                        <Button
                            Grid.Column="2"
                            Text="Amigos"
                            Command="{Binding ChangeFilterCommand}"
                            CommandParameter="Friends"
                            FontSize="13"
                            HeightRequest="34"
                            CornerRadius="10"
                            Padding="0,4"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            TextColor="#777">
                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding CurrentFilter}"
                                    Value="Friends">
                                    <Setter Property="BackgroundColor" Value="#5d259c" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- Favoritos -->
                        <Button
                            Grid.Column="3"
                            Text="Favoritos"
                            Command="{Binding ChangeFilterCommand}"
                            CommandParameter="Favorites"
                            FontSize="13"
                            HeightRequest="34"
                            CornerRadius="10"
                            Padding="0,4"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            TextColor="#777">
                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding CurrentFilter}"
                                    Value="Favorites">
                                    <Setter Property="BackgroundColor" Value="#5d259c" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                    </Grid>
                </Frame>
            </Grid>
        </Grid>

        <!-- MATCHES + AMIGOS HORIZONTAIS -->
        <StackLayout Grid.Row="1"
                     Spacing="12"
                     Margin="0,12,0,0">

            <!-- Matches -->
            <StackLayout Spacing="6">
                <Label
                    Text="Matches"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#555" />

                <CollectionView
                    x:Name="MatchesCollection"
                    ItemsSource="{Binding Matches}"
                    ItemsLayout="HorizontalList"
                    HeightRequest="92"
                    HorizontalScrollBarVisibility="Never"
                    SelectionMode="Single"
                    SelectionChanged="OnHorizontalChatSelectionChanged">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- HITBOX TOTAL (imagem + nome) -->
                            <Grid
                                BackgroundColor="Transparent"
                                Padding="6,4"
                                WidthRequest="80"
                                RowDefinitions="Auto,Auto">

                                <!-- Área do avatar: deixa transparente para clique ir para o CollectionView -->
                                <Grid Grid.Row="0" HorizontalOptions="Center">
                                    <!-- Avatar circular -->
                                    <Frame
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        CornerRadius="26"
                                        Padding="0"
                                        HasShadow="False"
                                        BackgroundColor="White"
                                        InputTransparent="True">
                                        <Image
                                            InputTransparent="True"
                                            Source="{Binding PhotoUrl, Converter={StaticResource AvatarSourceConverter}}"
                                            Aspect="AspectFill"
                                            WidthRequest="52"
                                            HeightRequest="52">
                                            <Image.Clip>
                                                <EllipseGeometry
                                                    Center="26,26"
                                                    RadiusX="26"
                                                    RadiusY="26" />
                                            </Image.Clip>
                                        </Image>
                                    </Frame>

                                    <!-- Coração de match -->
                                    <Frame
                                        InputTransparent="True"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        CornerRadius="9"
                                        BackgroundColor="#5d259c"
                                        Padding="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="End"
                                        Margin="0,0,2,2">
                                        <Label
                                            InputTransparent="True"
                                            Text="♥"
                                            FontSize="11"
                                            TextColor="White"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Frame>

                                    <!-- Estrela de favorito -->
                                    <Frame
                                        InputTransparent="True"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        CornerRadius="9"
                                        BackgroundColor="#FFD54F"
                                        Padding="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,2,2,0"
                                        IsVisible="{Binding IsFavorite}">
                                        <Label
                                            InputTransparent="True"
                                            Text="★"
                                            FontSize="11"
                                            TextColor="#5D4037"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Frame>

                                    <!-- Retângulo transparente “por cima” (garante toque no item) -->
                                    <BoxView
                                        BackgroundColor="Transparent"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Grid>

                                <Label
                                    Grid.Row="1"
                                    Text="{Binding DisplayName}"
                                    FontSize="11"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    Margin="0,4,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Amigos -->
            <StackLayout Spacing="6">
                <Label
                    Text="Amigos"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#555" />

                <CollectionView
                    x:Name="FriendsCollection"
                    ItemsSource="{Binding Friends}"
                    ItemsLayout="HorizontalList"
                    HeightRequest="92"
                    HorizontalScrollBarVisibility="Never"
                    SelectionMode="Single"
                    SelectionChanged="OnHorizontalChatSelectionChanged">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- HITBOX TOTAL (imagem + nome) -->
                            <Grid
                                BackgroundColor="Transparent"
                                Padding="6,4"
                                WidthRequest="80"
                                RowDefinitions="Auto,Auto">

                                <!-- Área do avatar: deixa transparente para clique ir para o CollectionView -->
                                <Grid Grid.Row="0" HorizontalOptions="Center">
                                    <!-- Avatar circular -->
                                    <Frame
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        CornerRadius="26"
                                        Padding="0"
                                        HasShadow="False"
                                        BackgroundColor="White"
                                        InputTransparent="True">
                                        <Image
                                            InputTransparent="True"
                                            Source="{Binding PhotoUrl, Converter={StaticResource AvatarSourceConverter}}"
                                            Aspect="AspectFill"
                                            WidthRequest="52"
                                            HeightRequest="52">
                                            <Image.Clip>
                                                <EllipseGeometry
                                                    Center="26,26"
                                                    RadiusX="26"
                                                    RadiusY="26" />
                                            </Image.Clip>
                                        </Image>
                                    </Frame>

                                    <!-- Estrela de favorito -->
                                    <Frame
                                        InputTransparent="True"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        CornerRadius="9"
                                        BackgroundColor="#FFD54F"
                                        Padding="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,2,2,0"
                                        IsVisible="{Binding IsFavorite}">
                                        <Label
                                            InputTransparent="True"
                                            Text="★"
                                            FontSize="11"
                                            TextColor="#5D4037"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Frame>

                                    <!-- Retângulo transparente “por cima” (garante toque no item) -->
                                    <BoxView
                                        BackgroundColor="Transparent"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Grid>

                                <Label
                                    Grid.Row="1"
                                    Text="{Binding DisplayName}"
                                    FontSize="11"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    Margin="0,4,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

        </StackLayout>

        <!-- LISTA DE CHATS -->
        <CollectionView
            Grid.Row="2"
            Margin="0,16,0,0"
            ItemsSource="{Binding FilteredChats}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        Padding="4,8"
                        Margin="0,0,0,4">

                        <!-- Avatar com ícones (menor) -->
                        <Grid Grid.Column="0">
                            <Frame
                                WidthRequest="48"
                                HeightRequest="48"
                                CornerRadius="24"
                                Padding="0"
                                BackgroundColor="White">
                                <Image
                                    Source="{Binding PhotoUrl, Converter={StaticResource AvatarSourceConverter}}"
                                    Aspect="AspectFill"
                                    WidthRequest="48"
                                    HeightRequest="48">
                                    <Image.Clip>
                                        <EllipseGeometry
                                            Center="24,24"
                                            RadiusX="24"
                                            RadiusY="24" />
                                    </Image.Clip>
                                </Image>
                            </Frame>

                            <!-- Coração se for match -->
                            <Frame
                                IsVisible="{Binding IsMatch}"
                                WidthRequest="18"
                                HeightRequest="18"
                                CornerRadius="9"
                                BackgroundColor="#5d259c"
                                Padding="0"
                                HorizontalOptions="End"
                                VerticalOptions="End"
                                Margin="0,0,1,1">
                                <Label
                                    Text="♥"
                                    FontSize="10"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Frame>

                            <!-- Estrela se for favorito -->
                            <Frame
                                IsVisible="{Binding IsFavorite}"
                                WidthRequest="18"
                                HeightRequest="18"
                                CornerRadius="9"
                                BackgroundColor="#FFD54F"
                                Padding="0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,1,1,0">
                                <Label
                                    Text="★"
                                    FontSize="10"
                                    TextColor="#5D4037"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Frame>
                        </Grid>

                        <!-- Nome + preview da mensagem -->
                        <StackLayout
                            Grid.Column="1"
                            Spacing="2"
                            Margin="10,0,0,0">
                            <Label
                                Text="{Binding DisplayName}"
                                FontAttributes="Bold"
                                TextColor="#262626" />
                            <Label
                                Text="{Binding LastMessagePreview}"
                                FontSize="12"
                                TextColor="#777"
                                LineBreakMode="TailTruncation" />
                        </StackLayout>

                        <!-- Hora + badge não lida -->
                        <StackLayout
                            Grid.Column="2"
                            Spacing="4"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                            <Label
                                Text="{Binding LastMessageAt, StringFormat='{0:HH\\:mm}'}"
                                FontSize="11"
                                TextColor="#999" />
                            <Frame
                                Style="{StaticResource UnreadBadgeStyle}"
                                Padding="4"
                                CornerRadius="10"
                                BackgroundColor="#5d259c">
                                <Label
                                    Text="{Binding UnreadCount}"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center" />
                            </Frame>
                        </StackLayout>

                        <!-- Tap geral do item -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnChatTapped"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
